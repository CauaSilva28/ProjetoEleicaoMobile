<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#400A00"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- TÍTULO DA LISTA -->
    <TextView
        android:id="@+id/tituloPrincipaisProblemas"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:gravity="center"
        android:text="Principais Problemas"
        android:textColor="#FFFFFF"
        android:textSize="26sp"
        android:textStyle="bold" />

    <!-- SAÚDE -->
    <CheckBox
        android:id="@+id/checkSaude"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Saúde"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        app:buttonTint="#FFFFFF" />

    <!-- EDUCAÇÃO -->
    <CheckBox
        android:id="@+id/checkEducacao"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Educação"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        app:buttonTint="#FFFFFF" />

    <!-- TRANSPORTE -->
    <CheckBox
        android:id="@+id/checkTransporte"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Transporte"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        app:buttonTint="#FFFFFF" />

    <!-- VIOLÊNCIA -->
    <CheckBox
        android:id="@+id/checkViolencia"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Violência"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        app:buttonTint="#FFFFFF" />

    <!-- MEIO AMBIENTE -->
    <CheckBox
        android:id="@+id/checkMeioAmbiente"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Meio ambiente"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        app:buttonTint="#FFFFFF" />

    <!-- TECNOLOGIA -->
    <CheckBox
        android:id="@+id/checkTecnologia"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tecnologia"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        app:buttonTint="#FFFFFF" />

    <!-- ARBORIZAÇÃO -->
    <CheckBox
        android:id="@+id/checkArborizacao"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Arborização"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        app:buttonTint="#FFFFFF" />

    <!-- ECONOMIA -->
    <CheckBox
        android:id="@+id/checkEconomia"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Economia"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        app:buttonTint="#FFFFFF" />

    <!-- NATALIDADE -->
    <CheckBox
        android:id="@+id/checkNatalidade"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Natalidade"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        app:buttonTint="#FFFFFF" />

    <!-- ESPAÇO -->
    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- BOTÃO -->
    <Button
        android:id="@+id/buttonConfirmarProblemas"
        android:layout_width="160dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:backgroundTint="#920A00"
        android:text="Confirmar"
        android:textAllCaps="false" />

</LinearLayout>