<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#400A00"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="24dp"
    tools:context=".Resultado">

    <TextView
        android:id="@+id/tvTotalEntrevistados"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Quantidade de pessoas entrevistadas: 0"
        android:textColor="#FFFFFF"
        android:textSize="22sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:layout_marginBottom="20dp"
        android:text="Quantidade de votos para cada candidato:"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"/>

    <!-- ScrollView para caso a lista fique muito grande -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Contêiner onde o Kotlin vai jogar os resultados -->
        <LinearLayout
            android:id="@+id/containerResultados"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </ScrollView>

</LinearLayout>